# Django core
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# For local phone testing only, use:
# DJANGO_ALLOWED_HOSTS=*

# Email / account flows
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=youraddress@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=Portail PGH <youraddress@gmail.com>
SITE_BASE_URL=http://127.0.0.1:8000

# Power BI Dashboard Configuration
# Leave empty until the real Power BI link is available.
POWERBI_DASHBOARD_EMBED_URL=
POWERBI_DASHBOARD_OPEN_URL=

# Public embed (Publish to Web) example:
# POWERBI_DASHBOARD_EMBED_URL=https://app.powerbi.com/view?r=...

# Secure embed example (requires authentication):
# POWERBI_DASHBOARD_EMBED_URL=https://app.powerbi.com/reportEmbed?reportId=...&autoAuth=true
# POWERBI_DASHBOARD_OPEN_URL=https://app.powerbi.com/groups/me/reports/...
